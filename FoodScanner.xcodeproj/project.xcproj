          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "Romain-MULLOT.FoodScannerUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
