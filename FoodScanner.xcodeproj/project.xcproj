  "targets": [
    {
      "name": "FoodScanner",
      "id": "7AC16F2A217E1E3300C4B381",
      "product": "Products/FoodScanner.app",
      "product-type": "application",
      "last-swift-migration": "11.2",
      "build-phases": [
        {
          "kind": "script",
          "name": "SwiftGen",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/swiftgen.yml",
            "$(SRCROOT)/FoodScanner/Assets.xcassets",
            "$(SRCROOT)/FoodScanner/fr.lproj/Localizable.strings",
            "$(SRCROOT)/FoodScanner/SFSymbols.yml",
          ],
          "output-paths": [
            "$(SRCROOT)/FoodScanner/Generated/Assets.swift",
            "$(SRCROOT)/FoodScanner/Generated/Strings.swift",
            "$(SRCROOT)/FoodScanner/Generated/SFSymbols.swift",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "SWIFTGEN_BIN=\"\"",
            "# Apple Silicon (M1/M2/M3/M4 \"Mx\") Macs install Homebrew under /opt/homebrew;",
            "# Intel Macs use /usr/local. Check both explicit locations before falling back",
            "# to PATH, since Xcode's script-phase PATH does not always include Homebrew's",
            "# bin dir (especially under arch translation or a minimal login shell).",
            "if [ -x \"${BUILD_DIR%/Build/*}/SourcePackages/artifacts/swiftgen/SwiftGenPlugin/bin/swiftgen\" ]; then",
            "  SWIFTGEN_BIN=\"${BUILD_DIR%/Build/*}/SourcePackages/artifacts/swiftgen/SwiftGenPlugin/bin/swiftgen\"",
            "elif [ -x /opt/homebrew/bin/swiftgen ]; then",
            "  SWIFTGEN_BIN=/opt/homebrew/bin/swiftgen",
            "elif [ -x /usr/local/bin/swiftgen ]; then",
            "  SWIFTGEN_BIN=/usr/local/bin/swiftgen",
            "elif which swiftgen > /dev/null 2>&1; then",
            "  SWIFTGEN_BIN=\"$(which swiftgen)\"",
            "elif which mint > /dev/null 2>&1; then",
            "  SWIFTGEN_BIN=\"mint run swiftgen\"",
            "fi",
            "",
            "if [ -z \"$SWIFTGEN_BIN\" ]; then",
            "  echo \"warning: swiftgen not found (checked SPM artifacts, /opt/homebrew, /usr/local, PATH, Mint). Skipping code generation. Install with 'brew install swiftgen' to enable.\"",
            "  exit 0",
            "fi",
            "",
            "if ! mkdir -p \"${SRCROOT}/FoodScanner/Generated\" 2>/tmp/swiftgen-mkdir-err.log; then",
            "  echo \"warning: could not create FoodScanner/Generated (sandboxed script build phase, e.g. ENABLE_USER_SCRIPT_SANDBOXING). Skipping SwiftGen code generation. Disable script sandboxing or run swiftgen manually to enable.\"",
            "  exit 0",
            "fi",
            "",
            "if ! $SWIFTGEN_BIN config run --config \"${SRCROOT}/swiftgen.yml\" 2>/tmp/swiftgen-run-err.log; then",
            "  echo \"warning: swiftgen run failed, skipping code generation. See /tmp/swiftgen-run-err.log\"",
            "  exit 0",
            "fi",
            "",
          ],
        }, {
          "kind": "script",
          "name": "SwiftLint",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "SWIFTLINT_BIN=\"\"",
            "# Apple Silicon (M1/M2/M3/M4 \"Mx\") Macs install Homebrew under /opt/homebrew;",
            "# Intel Macs use /usr/local. Check both explicit locations before falling back",
            "# to PATH, since Xcode's script-phase PATH does not always include Homebrew's",
            "# bin dir (especially under arch translation or a minimal login shell).",
            "if [ -x /opt/homebrew/bin/swiftlint ]; then",
            "  SWIFTLINT_BIN=/opt/homebrew/bin/swiftlint",
            "elif [ -x /usr/local/bin/swiftlint ]; then",
            "  SWIFTLINT_BIN=/usr/local/bin/swiftlint",
            "elif command -v swiftlint > /dev/null 2>&1; then",
            "  SWIFTLINT_BIN=\"$(command -v swiftlint)\"",
            "fi",
            "",
            "if [ -z \"$SWIFTLINT_BIN\" ]; then",
            "  echo \"warning: SwiftLint not installed, download from https://github.com/realm/SwiftLint\"",
            "  exit 0",
            "fi",
            "",
            "cd \"${SRCROOT}\" && \"$SWIFTLINT_BIN\" lint --strict",
            "",
          ],
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "FoodScannerUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "realm-swift",
          "product-name": "RealmSwift",
          "build-phase": { "build-phase": "copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
        }, {
          "package": "realm-swift",
          "product-name": "RealmSwift",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "realm-swift",
          "product-name": "RealmSwift",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "FoodScanner/FoodScanner.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "8JCA7TZP65",
        "INFOPLIST_FILE": "FoodScanner/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Food Scanner",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.food-and-drink",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.MULLOTRomainEI.FoodScanner",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "FoodScannerTests",
      "id": "7AC16F41217E1E3400C4B381",
